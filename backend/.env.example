# ==============================================================================
# Environment Configuration Template
# Copy this file to .env in the backend folder or project root
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# SQLite Database Location (relative to backend directory or absolute path)
# Default points to supply-chain-resilience/data/supply_chain.db
DATABASE_PATH=../data/supply_chain.db

# Frontend CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
